{
  "name": "yuppi",
  "version": "2.0.0",
  "description": "Portable and simple schemas for property validation.",
  "license": "MIT",
  "homepage": "https://github.com/keift/yuppi",
  "repository": "https://github.com/keift/yuppi",
  "scripts": {
    "tests": "bun run lint && bun test",
    "retouch": "bun run prettier",
    "build": "tsdown",
    "lint": "eslint ./",
    "prettier": "prettier --write ./"
  },
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/lodash.merge": "^4.6.9",
    "json-schema-to-typescript": "^15.0.4",
    "lodash.merge": "^4.6.2",
    "slugify": "^1.6.9",
    "typof": "^1.1.3"
  },
  "devDependencies": {
    "prettier": "latest",
    "rulint": "latest",
    "tsdown": "latest",
    "unrun": "latest"
  },
  "keywords": [
    "validate",
    "validation",
    "typecheck",
    "json-schema",
    "openapi"
  ]
}
